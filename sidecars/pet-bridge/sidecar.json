  "ui_config": {
    "display_name": "AGY 桌宠",
    "views": [
      {
        "title": "AGY 桌宠",
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE"
      }
    ]
  }
}
