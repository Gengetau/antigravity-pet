{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Token Meter",
  "description": "显示各模型消耗的 Token 数量（输入/输出/思考/缓存命中）与实时 token/s 计速、TTFT 首响延迟。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Token Meter",
    "views": [
      {
        "title": "Token Meter",
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE"
      }
    ]
  }
}
